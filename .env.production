# Production — CRA loads this automatically with `npm run build`.
# EMPTY value = same-origin requests (correct for the nginx setup where
# /api/ is proxied to gunicorn on the same domain). If the API ever lives
# on its own subdomain instead, set e.g. https://api.mechpro.co.ke
REACT_APP_API_URL=https://api.mechpro.co.ke
